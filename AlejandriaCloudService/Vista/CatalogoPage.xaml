<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AlejandriaCloudService.Vista.CatalogoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AlejandriaCloudService.Models"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F4F7FA"
    >

    <Grid
        Padding="22,42,22,0"
        RowDefinitions="Auto, *, Auto"
        RowSpacing="12">

        <SearchBar
            x:Name="BuscadorLibros"
            Grid.Row="0"
            BackgroundColor="White"
            CancelButtonColor="#2C5364"
            HorizontalOptions="Center"
            Placeholder="Buscar por título, autor o categoría..."
            TextChanged="OnBuscarTextChanged"
            WidthRequest="420" />

        <CollectionView
            x:Name="ListaLibros"
            Grid.Row="1"
            EmptyView="No se han encontrado libros en el catálogo."
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Libro">
            <Border
                        Margin="0,0,0,4"
                        Padding="10,9"
                        BackgroundColor="White"
                        Stroke="#D9DEE2"
                        StrokeShape="RoundRectangle 7"
                        StrokeThickness="1">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnVerDetalleTapped" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding titulo}"
                                    TextColor="#111111" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding autor}"
                                    TextColor="#333333" />
                                <Label
                                    FontAttributes="Italic"
                                    FontSize="11"
                                    Text="{Binding categoria}"
                                    TextColor="#222222" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#D8EED8"
                                Padding="8,4"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">
                                <Label
                                    FontSize="11"
                                    Text="{Binding estado}"
                                    TextColor="#245B2A" />
                            </Border>

                            <Button
                                Grid.Column="2"
                                BackgroundColor="#B71C27"
                                Clicked="OnEliminarClicked"
                                CommandParameter="{Binding .}"
                                CornerRadius="16"
                                FontSize="12"
                                HeightRequest="34"
                                MinimumWidthRequest="70"
                                Padding="8,0"
                                Text="Eliminar"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            BackgroundColor="#214F63"
            Clicked="OnVolverInicioClicked"
            CornerRadius="20"
            FontAttributes="Bold"
            Margin="0,0,0,15"
            Text="← Volver al inicio"
            TextColor="White"
            VerticalOptions="End" />
    </Grid>
</ContentPage>
