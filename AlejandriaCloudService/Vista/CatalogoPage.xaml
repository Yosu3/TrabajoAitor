<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AlejandriaCloudService.Vista.CatalogoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AlejandriaCloudService.Models"
    Title="Catálogo de Libros">

    <Grid
        Padding="15"
        RowDefinitions="Auto, *"
        RowSpacing="10">

        <SearchBar
            x:Name="BuscadorLibros"
            Grid.Row="0"
            Placeholder="Buscar por título, autor o categoría..."
            TextChanged="OnBuscarTextChanged" />

        <CollectionView
            x:Name="ListaLibros"
            Grid.Row="1"
            EmptyView="No se han encontrado libros en el catálogo."
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Libro">
                    <Border
                        Margin="0,4"
                        Padding="12"
                        BackgroundColor="#FAFAFA"
                        Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">

                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="OnVerDetalleTapped" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding titulo}"
                                    TextColor="#1B5E20" />
                                <Label
                                    FontSize="14"
                                    Text="{Binding autor}"
                                    TextColor="Gray" />
                                <Label
                                    FontAttributes="Italic"
                                    FontSize="12"
                                    Text="{Binding categoria}"
                                    TextColor="DimGray" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                Text="{Binding estado}"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="2"
                                BackgroundColor="#C62828"
                                Clicked="OnEliminarClicked"
                                CommandParameter="{Binding .}"
                                CornerRadius="8"
                                FontSize="12"
                                HeightRequest="36"
                                Padding="10,0"
                                Text="Eliminar"
                                TextColor="White"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
