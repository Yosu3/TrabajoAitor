<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AlejandriaCloudService.Vista.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#0F2027" />
            <GradientStop Offset="0.5" Color="#203A43" />
            <GradientStop Offset="1.0" Color="#2C5364" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView Padding="16,24" HorizontalOptions="Fill" VerticalOptions="Fill">
        <VerticalStackLayout HorizontalOptions="Fill" Spacing="20">

            <Image
                Margin="0,0,0,10"
                HeightRequest="100"
                HorizontalOptions="Center"
                Source="library_logo.png"
                WidthRequest="100" />

            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label
                    FontAttributes="Bold"
                    FontSize="32"
                    HorizontalOptions="Center"
                    Text="Alejandría Cloud"
                    TextColor="White" />
                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Gestión de Biblioteca"
                    TextColor="#DDE9EE" />
            </VerticalStackLayout>

            <Border
                Margin="0,10"
                Padding="20"
                Background="White"
                HorizontalOptions="Fill"
                MaximumWidthRequest="360"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.3"
                        Radius="15"
                        Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Nombre de Usuario"
                            TextColor="#2C5364" />
                        <Border
                            Padding="10,2"
                            Stroke="#E0E6ED"
                            StrokeShape="RoundRectangle 8">
                            <Entry
                                x:Name="txtUsername"
                                Keyboard="Text"
                                Placeholder="ej. jdoe"
                                PlaceholderColor="#617783"
                                TextColor="#203A43" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="Contraseña"
                            TextColor="#2C5364" />
                        <Border
                            Padding="10,2"
                            Stroke="#E0E6ED"
                            StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry
                                    x:Name="txtPassword"
                                    Grid.Column="0"
                                    IsPassword="True"
                                    Placeholder="••••••••"
                                    PlaceholderColor="#617783"
                                    TextColor="#203A43"
                                    VerticalOptions="Center" />

                                <ImageButton
                                    x:Name="btnTogglePassword"
                                    Grid.Column="1"
                                    Source="mostrar_contrasena.png"
                                    Aspect="AspectFit"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    BorderWidth="0"
                                    Clicked="OnTogglePasswordClicked"
                                    SemanticProperties.Description="Mostrar contraseña"
                                    HeightRequest="44"
                                    VerticalOptions="Center"
                                    WidthRequest="44" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        Margin="0,10,0,0"
                        BackgroundColor="#2C5364"
                        Clicked="OnLoginClicked"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Iniciar Sesión"
                        TextColor="White" />

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label
                    FontSize="14"
                    Text="¿No tienes cuenta?"
                    TextColor="#DDE9EE" />
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Regístrate aquí"
                    TextColor="#A3E5ED">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
