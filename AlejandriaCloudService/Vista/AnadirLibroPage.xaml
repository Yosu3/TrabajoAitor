<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AlejandriaCloudService.Vista.AnadirLibroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource LibrarySurface}"
    Title="Añadir libro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label
                Style="{StaticResource LibraryPageTitle}"
                Text="Nuevo libro"
                TextColor="{StaticResource LibraryGreen}" />

            <Label Text="Título *" />
            <Entry x:Name="TituloEntry" Placeholder="Ej: Don Quijote de la Mancha" />

            <Label Text="Autor *" />
            <Entry x:Name="AutorEntry" Placeholder="Ej: Miguel de Cervantes" />

            <Label Text="Categoría *" />
            <Picker x:Name="CategoriaPicker" Title="Elige una categoría" />

            <Label Text="Ubicación *" />
            <Entry x:Name="UbicacionEntry" Placeholder="Ej: Estantería A-03" />

            <Label Text="ISBN (opcional)" />
            <Entry
                x:Name="IsbnEntry"
                Keyboard="Numeric"
                Placeholder="Ej: 9788424116605" />

            <Label Text="Fecha de publicación" />
            <DatePicker x:Name="FechaPicker" />

            <Button
                x:Name="GuardarButton"
                Style="{StaticResource LibraryPrimaryButton}"
                Margin="0,10,0,0"
                BackgroundColor="{StaticResource LibraryGreen}"
                Clicked="GuardarClicked"
                FontAttributes="Bold"
                Text="Guardar libro"
                TextColor="White" />

            <Button
                Style="{StaticResource LibrarySecondaryButton}"
                BackgroundColor="{StaticResource LibraryTeal}"
                Clicked="OnVolverInicioClicked"
                CornerRadius="8"
                FontAttributes="Bold"
                Text="← Volver al inicio"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
