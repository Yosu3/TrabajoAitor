<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlejandriaCloudService.Vista.DetalleLibroPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F7FA">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="12">
            <Image x:Name="PortadaImagen"
                   WidthRequest="165" HeightRequest="230"
                   Aspect="AspectFit"
                   BackgroundColor="#E6ECEF"
                   HorizontalOptions="Center" />
            <Label x:Name="TituloLabel" FontSize="24" FontAttributes="Bold" TextColor="#1B4F5F" />
            <Label x:Name="AutorLabel" TextColor="#263B43" />
            <Label x:Name="CategoriaLabel" TextColor="#263B43" />
            <Label x:Name="IsbnLabel" TextColor="#263B43" />
            <Label x:Name="UbicacionLabel" TextColor="#263B43" />
            <Label x:Name="PublicacionLabel" TextColor="#263B43" />
            <Label x:Name="EstadoLabel" FontAttributes="Bold" TextColor="#176B77" />
            <Label x:Name="DisponibilidadLabel" TextColor="#52646B" />
            <Button x:Name="GestionarLibroButton"
                    IsVisible="False"
                    Clicked="OnGestionarLibroClicked"
                    BackgroundColor="#B34040"
                    TextColor="White" />
            <Button Text="Volver al catálogo"
                    Clicked="VolverClicked"
                    BackgroundColor="#326F85"
                    TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>