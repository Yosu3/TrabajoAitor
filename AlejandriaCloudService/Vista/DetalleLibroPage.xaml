<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AlejandriaCloudService.Vista.DetalleLibroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource LibrarySurface}"
    Title="Detalle del libro"
     NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label
                x:Name="TituloLabel"
                Style="{StaticResource LibraryPageTitle}"
                FontAttributes="Bold"
                FontSize="26"
                TextColor="{StaticResource LibraryGreen}" />

            <Label x:Name="AutorLabel" FontSize="18" />
            <Label x:Name="CategoriaLabel" />
            <Label x:Name="IsbnLabel" />
            <Label x:Name="UbicacionLabel" />
            <Label x:Name="PublicacionLabel" />

            <Label
                x:Name="EstadoLabel"
                FontAttributes="Bold"
                FontSize="20" />
            <Label x:Name="DisponibilidadLabel" />

            <Button
                Style="{StaticResource LibraryPrimaryButton}"
                BackgroundColor="{StaticResource LibraryGreen}"
                Clicked="VolverClicked"
                FontAttributes="Bold"
                Margin="0,15,0,0"
                Text="Volver al catálogo"
                TextColor="White" />

            <Button
                BackgroundColor="#C62828"
                CornerRadius="10"
                FontAttributes="Bold"
                Clicked="EliminarClicked"
                Text="Eliminar este libro"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
